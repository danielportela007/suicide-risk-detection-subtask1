            "colloquial",
            "functional"
          ],
          "explicitness": "mixed",
          "temporality": "current",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__indicator__mp__06",
          "text": "Since the breakup, I've been a complete emotional mess.",
          "expression_modes": [
            "colloquial",
            "temporal_or_situational"
          ],
          "explicitness": "mixed",
          "temporality": "current",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__indicator__mp__07",
          "text": "Maybe I am overreacting, but everything feels painfully difficult right now.",
          "expression_modes": [
            "hesitant_or_evasive"
          ],
          "explicitness": "mixed",
          "temporality": "current",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__indicator__mp__08",
          "text": "I do not usually admit how badly my anxiety affects me.",
          "expression_modes": [
            "hesitant_or_evasive"
          ],
          "explicitness": "explicit",
          "temporality": "general",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__indicator__mp__09",
          "text": "No sleep, no focus... just constant pressure.",
          "expression_modes": [
            "fragment_or_disfluency"
          ],
          "explicitness": "mixed",
          "temporality": "current",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__indicator__mp__10",
          "text": "Honestly, the sadness... it has been relentless.",
          "expression_modes": [
            "fragment_or_disfluency"
          ],
          "explicitness": "mixed",
          "temporality": "current",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__indicator__mp__11",
          "text": "I miss deadlines because my concentration disappears whenever stress rises.",
          "expression_modes": [
            "functional"
          ],
          "explicitness": "mixed",
          "temporality": "recurring",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__indicator__mp__12",
          "text": "I avoid social plans because I feel too drained to participate.",
          "expression_modes": [
            "functional"
          ],
          "explicitness": "mixed",
          "temporality": "recurring",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__indicator__mp__13",
          "text": "After losing my job, I have struggled to maintain any routine.",
          "expression_modes": [
            "temporal_or_situational"
          ],
          "explicitness": "mixed",
          "temporality": "current",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__indicator__mp__14",
          "text": "When my pain flares, even getting dressed becomes an exhausting challenge.",
