      "phrases": [
        {
          "id": "risk_levels__ideation__mp__01",
          "text": "My thoughts keep returning to the idea that I should no longer be alive.",
          "expression_modes": [
            "indirect"
          ],
          "explicitness": "mixed",
          "temporality": "recurring",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__ideation__mp__02",
          "text": "Some mornings, I wish there were no more mornings for me.",
          "expression_modes": [
            "indirect",
            "temporal_or_situational"
          ],
          "explicitness": "mixed",
          "temporality": "recurring",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__ideation__mp__03",
          "text": "I avoid quiet moments because thoughts of ending my life return then.",
          "expression_modes": [
            "indirect",
            "functional"
          ],
          "explicitness": "mixed",
          "temporality": "recurring",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__ideation__mp__04",
          "text": "I can't stop thinking I'd rather be dead.",
