      "phrases": [
        {
          "id": "risk_levels__indicator__mp__01",
          "text": "Every ordinary task feels heavier than it has any right to feel.",
          "expression_modes": [
            "indirect"
          ],
          "explicitness": "indirect",
          "temporality": "current",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__indicator__mp__02",
          "text": "Lately, I wake up already exhausted by the day ahead.",
          "expression_modes": [
            "indirect",
            "temporal_or_situational"
          ],
          "explicitness": "indirect",
          "temporality": "current",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__indicator__mp__03",
          "text": "I leave messages unanswered because conversation takes more energy than I have.",
          "expression_modes": [
            "indirect",
            "functional"
          ],
          "explicitness": "mixed",
          "temporality": "recurring",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__indicator__mp__04",
          "text": "I just can't catch a break from the stress.",
          "expression_modes": [
            "colloquial"
          ],
          "explicitness": "mixed",
          "temporality": "current",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__indicator__mp__05",
          "text": "I've barely kept up with laundry or meals this week.",
