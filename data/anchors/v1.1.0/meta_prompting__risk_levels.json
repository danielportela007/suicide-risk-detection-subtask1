            "colloquial",
            "functional"
          ],
          "explicitness": "mixed",
          "temporality": "current",
          "curation_status": "approved_original"
        },
        {
          "id": "risk_levels__ideation__mp__06",
          "text": "When things get quiet at night, I keep wishing I wasn't alive.",
